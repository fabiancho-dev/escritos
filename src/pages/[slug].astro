---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Lectura from '../layouts/Lectura.astro';

export const getStaticPaths = (async () => {
  const escritos = await getCollection('escritos');
  return escritos.map((escrito) => ({
    params: { slug: escrito.id },
    props: { escrito },
  }));
}) satisfies GetStaticPaths;

const { escrito } = Astro.props;
const { Content } = await render(escrito);
const { titulo, fecha, resumen } = escrito.data;

// La fecha del frontmatter es un día calendario sin hora (YAML la lee como
// medianoche UTC): se formatea en UTC para que no retroceda un día en Colombia.
const fechaLarga = new Intl.DateTimeFormat('es-CO', {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(fecha);
const fechaIso = fecha.toISOString().slice(0, 10);
---

<Lectura titulo={titulo} descripcion={resumen}>
  <article>
    <header class="encabezado">
      <h1>{titulo}</h1>
      <p class="fecha"><time datetime={fechaIso}>{fechaLarga}</time></p>
    </header>
    <div class="cuerpo">
      <Content />
    </div>
  </article>
</Lectura>
