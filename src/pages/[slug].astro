---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Hero from '../components/Hero.astro';
import Lectura from '../layouts/Lectura.astro';
import { ETIQUETAS_TIPO, fechaLarga, minutosDeLectura } from '../lib/lectura';

export const getStaticPaths = (async () => {
  const escritos = await getCollection('escritos');
  return escritos.map((escrito) => ({
    params: { slug: escrito.id },
    props: { escrito },
  }));
}) satisfies GetStaticPaths;

const { escrito } = Astro.props;
const { Content } = await render(escrito);
const { titulo, fecha, resumen, tipo, imagen, imagenAlt, imagenPosicion, imagenColor, marca } = escrito.data;
---

<Lectura titulo={titulo} descripcion={resumen} marca={marca} tituloHeader={titulo}>
  <article>
    <Hero
      categoria={ETIQUETAS_TIPO[tipo]}
      titulo={titulo}
      subtitulo={resumen}
      fecha={fecha}
      fechaLarga={fechaLarga(fecha)}
      minutosLectura={minutosDeLectura(escrito.body ?? '')}
      imagen={imagen}
      imagenAlt={imagenAlt}
      imagenPosicion={imagenPosicion}
      imagenColor={imagenColor}
    />
    <div class="cuerpo">
      <Content />
    </div>
  </article>
</Lectura>
